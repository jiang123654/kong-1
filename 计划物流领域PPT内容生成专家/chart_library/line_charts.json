{
  "line_trend": {
    "name": "折线图-趋势类",
    "description": "用于月度趋势、同比对比等时序数据",
    "适用页面": ["数据页", "趋势分析页"],
    "baseOption": {
      "tooltip": {
        "trigger": "axis",
        "backgroundColor": "rgba(255, 255, 255, 0.95)",
        "borderColor": "#E5E7EB",
        "borderWidth": 1,
        "textStyle": { "color": "#1F2937", "fontSize": 12 }
      },
      "grid": { "left": "3%", "right": "4%", "bottom": "3%", "top": "15%", "containLabel": true },
      "legend": {
        "top": 0,
        "right": 0,
        "textStyle": { "color": "#4B5563", "fontSize": 11 },
        "itemWidth": 14,
        "itemHeight": 8
      },
      "xAxis": {
        "type": "category",
        "boundaryGap": false,
        "axisLabel": { "color": "#4B5563", "fontSize": 11 },
        "axisLine": { "lineStyle": { "color": "#E5E7EB" } }
      },
      "yAxis": {
        "type": "value",
        "nameTextStyle": { "color": "#9CA3AF", "fontSize": 11 },
        "axisLabel": { "color": "#9CA3AF", "fontSize": 11 },
        "splitLine": { "lineStyle": { "color": "#F3F4F6", "type": "dashed" } }
      },
      "series": [
        {
          "type": "line",
          "smooth": true,
          "symbol": "circle",
          "symbolSize": 6,
          "lineStyle": { "color": "#E60012", "width": 2 },
          "itemStyle": { "color": "#E60012" },
          "areaStyle": {
            "color": {
              "type": "linear", "x": 0, "y": 0, "x2": 0, "y2": 1,
              "colorStops": [
                { "offset": 0, "color": "rgba(230, 0, 18, 0.15)" },
                { "offset": 1, "color": "rgba(230, 0, 18, 0.02)" }
              ]
            }
          }
        },
        {
          "type": "line",
          "smooth": true,
          "symbol": "circle",
          "symbolSize": 6,
          "lineStyle": { "color": "#9CA3AF", "width": 2, "type": "dashed" },
          "itemStyle": { "color": "#9CA3AF" }
        }
      ]
    },
    "markLine": {
      "budgetLine": {
        "silent": true,
        "data": [{
          "yAxis": 0,
          "lineStyle": { "color": "#F59E0B", "type": "dashed", "width": 1 },
          "label": { "formatter": "预算线", "color": "#F59E0B", "fontSize": 10, "position": "end" }
        }]
      }
    }
  }
}
